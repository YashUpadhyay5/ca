# CaFinIQ Environment Configuration Blueprint

# Application
PROJECT_NAME="CaFinIQ - Bank Statement Intelligence Platform"
ENVIRONMENT="production"
DEBUG=false

# Security & Authentication
SECRET_KEY="replace_with_a_cryptographically_secure_random_key_64_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite for local dev)
DATABASE_URL="sqlite:///./storage/cafiniq.db"
# DATABASE_URL="postgresql://cafiniq_user:password@localhost:5432/cafiniq_db"

# Storage Configuration
MAX_UPLOAD_SIZE_BYTES=52428800
MASK_ACCOUNTS_BY_DEFAULT=true

# OCR & AI Fallback
OCR_ENGINE="rapidocr_onnx"
ENABLE_ONNX_ACCELERATION=true
